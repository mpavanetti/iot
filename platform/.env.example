# Copy to .env (next to compose.yaml) and adjust. Every value shown is the default.

# --- Host ports ---------------------------------------------------------------
# Dashboard: http://<host>:8000 (set 80 for plain http://raspberrypi.local/)
WEB_PORT=8000
# Where the Pico W firmware sends its readings (TCP)
GATEWAY_PORT=1500
# Streamlit analytics
ANALYTICS_PORT=8501
# Spark master UI, and the streaming job's own UI (Structured Streaming tab)
SPARK_UI_PORT=8080
SPARK_APP_PORT=4040
# Kafka for tools running on the host, e.g. the simulator's kafka:// mode
KAFKA_PORT=9094
# Kafka UI, only started with: docker compose --profile tools up -d
KAFKA_UI_PORT=8090
# PostgreSQL, bound to 127.0.0.1 only
POSTGRES_PORT=5432

# --- Kafka ----------------------------------------------------------------------
# The host name clients on *other* machines use to reach Kafka (e.g. raspberrypi.local).
# Keep localhost if only tools on this host connect.
KAFKA_EXTERNAL_HOST=localhost

# --- Spark worker size (a Raspberry Pi 4 with 8 GB handles the defaults) ------
# The streaming job takes SPARK_STREAMING_CORES and 768 MB; the rest is free for batch jobs
# such as `make rebuild-hourly`, so keep the worker at least one core bigger.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_STREAMING_CORES=1

# --- PostgreSQL password (used by Spark, the dashboard and Streamlit) ---------
POSTGRES_PASSWORD=iot

# --- Time zone for Streamlit, e.g. America/New_York (the dashboard uses the browser's)
TIMEZONE=UTC

# --- Altitude of the sensors in metres (e.g. 1045): the dashboard then also
# shows sea-level pressure, the figure weather reports quote. Empty: not shown.
ALTITUDE_M=

# --- How long PostgreSQL keeps data (the web app purges hourly; 0 keeps it forever) ---
RETENTION_DAYS=30           # every reading
HOURLY_RETENTION_DAYS=730   # hourly aggregates, behind the 7d to 1y charts
